#!/usr/bin/env bash
#SBATCH --job-name=s2g2p-lock
#SBATCH --account=bifo
#SBATCH --partition=cpu
#SBATCH --cpus-per-task=4
#SBATCH --mem=16G
#SBATCH --time=4:00:00
#SBATCH --nice=30000
#
# Regenerate the lock files that are solved here rather than copied from the reproduction
# (envs/<name>.lock.txt from envs/specs/<name>.txt), and print the checksums of the three upstream
# tarballs envs/install.sh downloads. Run it when a spec changes, then commit the locks and
# paste any changed checksum into envs/install.sh.
#
#   sbatch -o log/%x_%j.out dev/lock-envs.sbatch [prokka roary-deps s2g2p folds]
#
# Channels are conda-forge and bioconda only (defaults overridden). Priority is flexible: the
# specs pin Bioconda tools by version, and strict priority would hide them behind conda-forge
# packages of the same name.
set -euo pipefail
names=("$@")
[ ${#names[@]} -gt 0 ] || names=(prokka roary-deps s2g2p folds)
CONDA=${CONDA:-$HOME/miniforge3/bin/conda}
work=$(mktemp -d "${TMPDIR:-/tmp}/s2g2p-lock.XXXXXX")
trap 'rm -rf "$work"' EXIT
export CONDA_PKGS_DIRS="$work/pkgs"

for n in "${names[@]}"; do
    spec=envs/specs/$n.txt
    echo "== $n ($spec)"
    "$CONDA" create -y -q -p "$work/$n" --override-channels -c conda-forge -c bioconda \
        --no-channel-priority --file "$spec"
    {
        echo "# $n: generated by dev/lock-envs.sbatch from $spec on $(date -u +%F) -- do not edit"
        "$CONDA" list -p "$work/$n" --explicit --md5
    } > "envs/$n.lock.txt"
    grep -c '^https' "envs/$n.lock.txt"
    if grep -q 'conda.anaconda.org/anaconda\|repo.anaconda.com' "envs/$n.lock.txt"; then
        echo "FATAL: $n resolved packages from Anaconda's channels"; exit 1
    fi
done

echo "== upstream tarballs (sha256)"
while read -r url; do
    f="$work/$(basename "$url")"
    curl -fsSL --retry 3 -o "$f" "$url"
    echo "$(sha256sum "$f" | cut -d' ' -f1)  $url"
done <<'EOF'
https://github.com/hzi-bifo/Roary/archive/7402d1bab868d73b9c1e7cf30e8af8c5b2578313.tar.gz
https://ftp.ncbi.nlm.nih.gov/blast/executables/blast+/2.4.0/ncbi-blast-2.4.0+-x64-linux.tar.gz
https://ftp.gnu.org/gnu/parallel/parallel-20160722.tar.bz2
EOF
