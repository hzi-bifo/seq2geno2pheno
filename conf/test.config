// Stub wiring test: every process runs its `stub:` block, no tool and no image is needed.
//   nextflow run . -profile test -stub-run
params {
    input      = "${projectDir}/tests/data/samplesheet.tsv"
    outdir     = 'results-test'
    max_cpus   = 2
    max_memory = '4.GB'
    max_time   = '1.h'
}
