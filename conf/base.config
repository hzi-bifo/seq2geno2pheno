// Resource labels. Roary and the indel stage dominate: Roary measured 4.6 h (C. jejuni, 395
// genomes) to 39 h (S. pneumoniae, 4,757) at 10-32 CPUs in the Hu et al. 2024 reproduction.
// Every request is capped by params.max_cpus / max_memory / max_time through Nextflow's own
// resourceLimits (24.04+). It replaces `[x, params.max_memory as MemoryUnit].min()`, which needs
// the class names Nextflow imports into config files only from 25.x.
process {
    resourceLimits = [cpus: params.max_cpus as int, memory: params.max_memory, time: params.max_time]

    cpus   = 1
    memory = 4.GB
    time   = 4.h
    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 140, 143] ? 'retry' : 'finish' }
    maxRetries    = 1

    withLabel: 'process_single' {
        cpus   = 1
        memory = 4.GB
        time   = 1.h
    }
    withLabel: 'process_low' {
        cpus   = 2
        memory = 8.GB
        time   = 4.h
    }
    withLabel: 'process_medium' {
        cpus   = 8
        memory = 16.GB
        time   = 8.h
    }
    withLabel: 'process_high' {
        cpus   = { 16 * task.attempt }
        memory = { 64.GB * task.attempt }
        time   = { params.max_time }
    }
}
