// Resource labels. Roary and the indel stage dominate: Roary measured 4.6 h (C. jejuni, 395
// genomes) to 39 h (S. pneumoniae, 4,757) at 10-32 CPUs in the Hu et al. 2024 reproduction.
// Every request is capped by params.max_cpus / max_memory / max_time.
process {
    cpus   = 1
    memory = { [4.GB, params.max_memory as MemoryUnit].min() }
    time   = { [4.h, params.max_time as Duration].min() }
    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 140, 143] ? 'retry' : 'finish' }
    maxRetries    = 1

    withLabel: 'process_single' {
        cpus   = 1
        memory = { [4.GB, params.max_memory as MemoryUnit].min() }
        time   = { [1.h, params.max_time as Duration].min() }
    }
    withLabel: 'process_low' {
        cpus   = { Math.min(2, params.max_cpus as int) }
        memory = { [8.GB, params.max_memory as MemoryUnit].min() }
        time   = { [4.h, params.max_time as Duration].min() }
    }
    withLabel: 'process_medium' {
        cpus   = { Math.min(8, params.max_cpus as int) }
        memory = { [16.GB, params.max_memory as MemoryUnit].min() }
        time   = { [8.h, params.max_time as Duration].min() }
    }
    withLabel: 'process_high' {
        cpus   = { Math.min(16 * task.attempt, params.max_cpus as int) }
        memory = { [64.GB * task.attempt, params.max_memory as MemoryUnit].min() }
        time   = { params.max_time as Duration }
    }
}
