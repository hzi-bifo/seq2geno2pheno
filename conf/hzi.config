// HZI bioinf / metis. The two clusters share this tree but not partitions or accounts; pass
// them on the command line (CLI beats config):
//   nextflow run . -profile hzi,slurm,apptainer --slurm_account b_algbic --slurm_partition cpu ...
// Background runs queue behind interactive work at nice=30000 (the floor that actually reaches
// priority 1 on both clusters). Conda binaries built for AVX2 die with SIGILL (exit 132) on the
// older nodes, so add the placement to slurm_extra: metis declares the feature
// (--slurm_extra '--nice=30000 --constraint=avx2'); bioinf does not, so exclude by name
// (--slurm_extra '--nice=30000 --exclude=bioinf009').
params {
    slurm_account   = 'b_algbic'
    slurm_partition = 'cpu'
    slurm_extra     = '--nice=30000'
    containers {
        prokka = "${projectDir}/containers/images/prokka-1.14.6.sif"
        roary  = "${projectDir}/containers/images/s2g2p-tools.sif"
        tools  = "${projectDir}/containers/images/s2g2p-tools.sif"
        s2g2p  = "${projectDir}/containers/images/s2g2p.sif"
    }
}
process {
    queue          = { params.slurm_partition }
    clusterOptions = { "--account=${params.slurm_account} ${params.slurm_extra}" }
}

// Compute nodes export TMPDIR as a host path that is not mounted inside the container, and
// GNU parallel / Perl File::Temp (both used by Roary) die on it. The container's /tmp is the
// node's own /tmp, so point TMPDIR there.
apptainer.runOptions   = '--env TMPDIR=/tmp'
singularity.runOptions = '--env TMPDIR=/tmp'
