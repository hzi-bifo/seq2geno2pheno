// HZI bioinf / metis. Every job is charged to bifo, on both clusters; partitions differ (bioinf
// cpu, metis cpugpu), so pass them on the command line (CLI beats config):
//   nextflow run . -profile hzi,slurm,conda --slurm_partition cpu ...
// The image paths below are used only with -profile apptainer.
// Background runs queue behind interactive work at nice=30000 (the floor that actually reaches
// priority 1 on both clusters). Conda binaries built for AVX2 die with SIGILL (exit 132) on the
// older nodes, so add the placement to slurm_extra: metis declares the feature
// (--slurm_extra '--nice=30000 --constraint=avx2'); bioinf does not, so exclude by name
// (--slurm_extra '--nice=30000 --exclude=bioinf009').
params {
    slurm_account   = 'bifo'
    slurm_partition = 'cpu'
    slurm_extra     = '--nice=30000'
    // One association (bifo) runs at most 30 jobs for everything the user does; a run keeps
    // at most this many in the queue so other work still gets slots.
    slurm_queue_size = 10
    containers {
        prokka = "${projectDir}/containers/images/prokka-1.14.6.sif"
        roary  = "${projectDir}/containers/images/s2g2p-tools.sif"
        tools  = "${projectDir}/containers/images/s2g2p-tools.sif"
        s2g2p  = "${projectDir}/containers/images/s2g2p.sif"
        hu2024ml = "${projectDir}/containers/images/s2g2p-hu2024ml.sif"
    }
}
executor {
    queueSize = params.slurm_queue_size
    account   = params.slurm_account
}
process {
    queue          = { params.slurm_partition }
    clusterOptions = { params.slurm_extra }
}

// Compute nodes export TMPDIR as a host path that is not mounted inside the container, and
// GNU parallel / Perl File::Temp (both used by Roary) die on it. The container's /tmp is the
// node's own /tmp, so point TMPDIR there. GNU parallel (Prokka, Roary) runs commands through
// $SHELL, which is the host's login shell (zsh here) and absent from the images.
apptainer.runOptions   = '--env TMPDIR=/tmp --env SHELL=/bin/bash'
singularity.runOptions = '--env TMPDIR=/tmp --env SHELL=/bin/bash'
