// Seq2Geno2Pheno v3 -- workflow configuration.
// Method choices live in the preset (src/s2g2p/presets/<name>.yml), not here: this file only
// says where to run and with which tools: the environments of envs/install.sh (-profile
// conda, the default way to install) or container images (-profile docker/singularity/apptainer).

manifest {
    name            = 'hzi-bifo/seq2geno2pheno'
    description     = 'Genotype-phenotype prediction for bacterial genomes, with no information from the test set'
    homePage        = 'https://github.com/hzi-bifo/seq2geno2pheno'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.04.0'
    version         = '3.0.0.dev0'   // = s2g2p.__version__ (tests/test_version.py)
}

params {
    input               = null        // sample sheet: sample, assembly, [group], phenotype columns
    preset              = 'noleak'    // hu2024 | noleak | fast | g2p | path/to/preset.yml
    mode                = 'evaluate'  // evaluate | train | predict
    phenotype           = 'all'       // one phenotype column, or all of them
    folds               = null        // fold file; '{phenotype}' is replaced. Default: stratified random
    n_folds             = 10
    seed                = 0
    kmer_k              = 6
    model_dir           = null        // --mode predict: the outdir of a --mode train run
    outdir              = 'results'
    publish_dir_mode    = 'copy'
    publish_annotations = false

    // -profile conda: the prefix envs/install.sh installed into (also: --mode install)
    env_dir             = "${projectDir}/envs/installed"

    // Images (container profiles only). `tools` carries Seq2Geno's Roary 3.8.2 fork (hzi-bifo/Roary@7402d1b, its BLAST
    // 2.4.0), mafft 7.310, jvarkit msa2vcf 1.0 and s2g2p; see containers/README.md.
    containers {
        prokka = 'quay.io/biocontainers/prokka:1.14.6--pl5321hdfd78af_5'
        roary  = 'ghcr.io/hzi-bifo/seq2geno2pheno-tools:3.0.0dev'
        tools  = 'ghcr.io/hzi-bifo/seq2geno2pheno-tools:3.0.0dev'
        s2g2p  = 'ghcr.io/hzi-bifo/seq2geno2pheno:3.0.0dev'
        hu2024ml = 'ghcr.io/hzi-bifo/seq2geno2pheno-hu2024ml:3.0.0dev'   // presets with ml_env: hu2024
    }

    max_cpus   = 32
    max_memory = '128.GB'
    max_time   = '48.h'
}

profiles {
    // No containers: every tool from the environments envs/install.sh made under --env_dir.
    // Install once with `bash envs/install.sh` or `nextflow run ... --mode install`.
    conda {
        process {
            beforeScript = { "export PATH=${params.env_dir}/bin:\$PATH" }
            withName: 'EVALUATE' {
                // the preset's model environment (hu2024: the published scikit-learn 0.24.1)
                beforeScript = { "export PATH=${ml_env == 'hu2024' ? params.env_dir + '/bin-hu2024ml:' : ''}${params.env_dir}/bin:\$PATH" }
            }
        }
    }
    docker {
        docker.enabled      = true
        docker.runOptions   = '-u $(id -u):$(id -g)'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }
    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
    }
    slurm {
        process.executor = 'slurm'
    }
    // Wiring test without any tool: nextflow run . -profile test -stub-run
    test {
        includeConfig 'conf/test.config'
    }
    // HZI clusters (bioinf, metis): local images, background priority. See conf/hzi.config.
    hzi {
        includeConfig 'conf/hzi.config'
    }
}

// After the profiles: base.config's resourceLimits reads params.max_* when it is included, so it
// must come after any profile that sets them (test does).
includeConfig 'conf/base.config'

timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline.html"; overwrite = true }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report.html"; overwrite = true }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace.tsv"; overwrite = true }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/dag.html"; overwrite = true }
